
simple html flappy game

      
        Here is a complete, single-file Flappy Bird clone written in vanilla HTML, CSS, and JavaScript. It uses an HTML5 <canvas> element to render everything dynamically, meaning you do not need to download external images or audio files to play it.

How to Play

• Desktop: Press the Spacebar or Click/Tap the screen to jump.
• Mobile: Tap the screen to jump.

The Code (index.html)

Create a new file named index.html, paste the following code inside it, and double-click the file to open and play it in any web browser.
html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simple Flappy Bird</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #222;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            font-family: Arial, sans-serif;
            overflow: hidden;
        }
        #gameContainer {
            position: relative;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }
        canvas {
            background-color: #70c5ce;
            display: block;
            border-radius: 4px;
        }
        #scoreDisplay {
            position: absolute;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            color: white;
            font-size: 32px;
            font-weight: bold;
            text-shadow: 2px 2px 0 #000;
            z-index: 10;
            pointer-events: none;
        }
        #restartScreen {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.4);
            display: none;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: white;
            z-index: 20;
            border-radius: 4px;
        }
        #restartScreen h2 {
            font-size: 40px;
            margin-bottom: 10px;
            text-shadow: 2px 2px 0 #000;
        }
        #restartScreen p {
            font-size: 18px;
            margin-bottom: 20px;
        }
        #restartBtn {
            padding: 10px 20px;
            font-size: 18px;
            font-weight: bold;
            background-color: #f77f00;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            box-shadow: 0 4px 0 #d62828;
            transition: 0.1s;
        }
        #restartBtn:active {
            transform: translateY(4px);
            box-shadow: none;
        }
    </style>
</head>
<body>

<div id="gameContainer">
    <div id="scoreDisplay">0</div>
    <div id="restartScreen">
        <h2>Game Over</h2>
        <p>Click or Press Space to Restart</p>
        <button id="restartBtn">Play Again</button>
    </div>
    <canvas id="gameCanvas" width="360" height="540"></canvas>
</div>

<script>
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const scoreDisplay = document.getElementById('scoreDisplay');
const restartScreen = document.getElementById('restartScreen');
const restartBtn = document.getElementById('restartBtn');

// Game constants & variables
const GRAVITY = 0.25;      // How fast the bird falls
const JUMP = -5.3;         // How high the bird jumps
const PIPE_SPEED = 2;      // Leftward scrolling speed
const PIPE_SPAWN_RATE = 90;// Spawning frequency (in frames)
const PIPE_GAP = 120;      // Distance between top and bottom pipe

let bird;
let pipes;
let frameCount;
let score;
let gameOver;

class Bird {
    constructor() {
        this.x = 50;
        this.y = canvas.height / 2;
        this.radius = 14;
        this.velocity = 0;
    }

    draw() {
        ctx.fillStyle = '#ffde06'; // Flappy yellow
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = '#000';
        ctx.lineWidth = 2;
        ctx.stroke();

        // Eye
        ctx.fillStyle = '#fff';
        ctx.beginPath();
        ctx.arc(this.x + 6, this.y - 4, 5, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = '#000';
        ctx.beginPath();
        ctx.arc(this.x + 7, this.y - 4, 2, 0, Math.PI * 2);
        ctx.fill();

        // Beak
        ctx.fillStyle = '#ff7b00';
        ctx.beginPath();
        ctx.moveTo(this.x + 10, this.y - 2);
        ctx.lineTo(this.x + 22, this.y + 2);
        ctx.lineTo(this.x + 10, this.y + 6);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();
    }

    update() {
        this.velocity += GRAVITY;
        this.y += this.velocity;

        // Ground/ceiling boundary collision detection
        if (this.y + this.radius >= canvas.height) {
            this.y = canvas.height - this.radius;
            endGame();
        }
        if (this.y - this.radius <= 0) {
            this.y = this.radius;
            this.velocity = 0;
        }
    }

    flap() {
        this.velocity = JUMP;
    }
}

class Pipe {
    constructor() {
        // Randomize the height setup dynamically
        this.topHeight = Math.floor(Math.random() * (canvas.height - PIPE_GAP - 100)) + 50;
        this.bottomHeight = canvas.height - this.topHeight - PIPE_GAP;
        this.x = canvas.width;
        this.width = 52;
        this.passed = false;
    }

    draw() {
        ctx.fillStyle = '#73bf2e'; // Classic pipe green
        ctx.strokeStyle = '#000';
        ctx.lineWidth = 2;

        // Top Pipe
        ctx.fillRect(this.x, 0, this.width, this.topHeight);
        ctx.strokeRect(this.x, 0, this.width, this.topHeight);

        // Bottom Pipe
        ctx.fillRect(this.x, canvas.height - this.bottomHeight, this.width, this.bottomHeight);
        ctx.strokeRect(this.x, canvas.height - this.bottomHeight, this.width, this.bottomHeight);
    }

    update() {
        this.x -= PIPE_SPEED;
    }

    collidesWith(bird) {
        // Precise circular bounding-box collision logic
        let closestX = Math.max(this.x, Math.min(bird.x, this.x + this.width));
        
        // Check top pipe bounds
        let closestYTop = Math.max(0, Math.min(bird.y, this.topHeight));
        let distanceXTop = bird.x - closestX;
        let distanceYTop = bird.y - closestYTop;
        let distanceTop = Math.sqrt(distanceXTop * distanceXTop + distanceYTop * distanceYTop);

        // Check bottom pipe bounds
        let closestYBottom = Math.max(canvas.height - this.bottomHeight, Math.min(bird.y, canvas.height));
        let distanceXBottom = bird.x - closestX;
        let distanceYBottom = bird.y - closestYBottom;
        let distanceBottom = Math.sqrt(distanceXBottom * distanceXBottom + distanceYBottom * distanceYBottom);

        return (distanceTop < bird.radius || distanceBottom < bird.radius);
    }
}

function init() {
    bird = new Bird();
    pipes = [];
    frameCount = 0;
    score = 0;
    gameOver = false;
    scoreDisplay.innerText = score;
    restartScreen.style.display = 'none';
    gameLoop();
}

function gameLoop() {
    if (gameOver) return;

    ctx.clearRect(0, 0, canvas.width, canvas.height);

    // Spawning configuration
    if (frameCount % PIPE_SPAWN_RATE === 0) {
        pipes.push(new Pipe());
    }

    // Process all pipes
    for (let i = pipes.length - 1; i >= 0; i--) {
        pipes[i].update();
        pipes[i].draw();

        if (pipes[i].collidesWith(bird)) {
            endGame();
        }

        // Increment score
        if (!pipes[i].passed && pipes[i].x + pipes[i].width < bird.x) {
            score++;
            scoreDisplay.innerText = score;
            pipes[i].passed = true;
        }

        // Delete pipes off screen
        if (pipes[i].x + pipes[i].width < 0) {
            pipes.splice(i, 1);
        }
    }

    bird.update();
    bird.draw();
    frameCount++;

    requestAnimationFrame(gameLoop);
}

function endGame() {
    gameOver = true;
    restartScreen.style.display = 'flex';
}

function handleJump() {
    if (gameOver) {
        init();
    } else {
        bird.flap();
    }
}

// Global Event Listeners
window.addEventListener('keydown', (e) => {
    if (e.code === 'Space') {
        e.preventDefault(); // Prevents jumping layout behavior when hitting spacebar
        handleJump();
    }
});

canvas.addEventListener('touchstart', (e) => {
    e.preventDefault();
    handleJump();
});

canvas.addEventListener('mousedown', (e) => {
    handleJump();
});

restartBtn.addEventListener('click', (e) => {
    e.stopPropagation(); // Avoid triggering multiple jump states instantly
    init();
});

// Start the game framework natively on load
init();
</script>

</body>
</html>
